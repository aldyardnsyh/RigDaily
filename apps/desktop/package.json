  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "5.5.4",
    "@types/node": "20.12.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "@rigdaily/shared": "0.1.0"
  }
}
