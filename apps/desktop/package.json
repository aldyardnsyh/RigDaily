{
  "name": "@rigdaily/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "RigDaily Internal — terminal DDR rig (offline-first, Electron + SQLite).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
