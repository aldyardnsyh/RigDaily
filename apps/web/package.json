{
  "name": "@rigdaily/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node dev.js",
    /*
     * Build packages dulu SEBELUM next build.
     *
     * `dist/` tidak ikut ke Git (hasil kompilasi lokal), dan Vercel tidak
     * menjalankannya otomatis. Tanpa baris ini, `@rigdaily/shared` (yang
     * `main`-nya menunjuk `./dist/index.js`) tidak ketemu dan build gagal
     * dengan "Module not found: Can't resolve '@rigdaily/shared'".
     */
    "build": "npm run build -w @rigdaily/shared -w @rigdaily/ui -w @rigdaily/database && next build",
    "start": "next start"
  },
  "dependencies": {
    "@rigdaily/database": "0.1.0",
    "@rigdaily/shared": "0.1.0",
    "@rigdaily/ui": "0.1.0",
    "drizzle-orm": "^0.33.0",
    "jose": "^5.9.2",
    "lucide-react": "^1.45.0",
    "next": "^14.2.35",
    "pdfkit": "^0.15.0",
    "pg": "^8.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sonner": "^2.0.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.12.0",
    "@types/pdfkit": "^0.13.4",
    "@types/pg": "^8.11.6",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.40",
    "tailwindcss": "3.4.7",
    "typescript": "5.5.4"
  }
}
