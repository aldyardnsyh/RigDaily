# ============================================================================
# .env.example — salin ke `.env` lalu isi nilainya.
#   cp .env.example .env && chmod 600 .env
#
# JANGAN commit `.env` asli. Semua variabel di bawah diverifikasi dari kode
# nyata (grep `process.env` di apps/web & packages — lihat laporan deploy).
# Format: docker compose `env_file` (KEY=VALUE, tanpa spasi di sekitar '=').
# ============================================================================

# ---------------------------------------------------------------------------
# RUNTIME
# ---------------------------------------------------------------------------
# Mode runtime Node. Di produksi WAJIB `production` (mengaktifkan cookie
# `secure`, mematikan hint demo, dsb). Jangan diubah.
NODE_ENV=production

# Zona waktu container. Wajib Asia/Jakarta agar tanggal/jam laporan DDR benar.
# (Dipakai `date`, Postgres `timezone`, dan log.)
TZ=Asia/Jakarta

# Timeout tunggu DB siap saat container start (dibaca infra/docker/entrypoint.sh).
DB_WAIT_SECONDS=90

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
# Kredensial container PostgreSQL (dipakai service `db` & script backup/restore).
POSTGRES_USER=rigdaily
# GANTI: password acak kuat. Contoh menghasilkan yang aman:
#   openssl rand -base64 24
POSTGRES_PASSWORD=ganti-password-kuat-ini
POSTGRES_DB=rigdaily

# Koneksi yang dipakai aplikasi (apps/web & packages/database/client.ts).
# WAJIB Postgres di produksi. Host = `db` (nama service compose), BUKAN localhost.
DATABASE_URL=postgres://rigdaily:ganti-password-kuat-ini@db:5432/rigdaily

# Ukuran pool koneksi node-postgres (client.ts). 10 cukup untuk 2 vCPU.
# Total koneksi = PG_POOL_MAX * jumlah proses + margin; jaga < max_connections (40).
PG_POOL_MAX=10

# PENTING: KOSONGKAN di produksi. Bila diisi `pglite`, aplikasi memakai PGlite
# (file lokal di container) -> DATA HILANG setiap container dibuat ulang.
RIGDAILY_DRIVER=

# Direktori data PGlite (HANYA untuk dev lokal). KOSONGKAN di produksi.
PGLITE_DIR=

# ---------------------------------------------------------------------------
# BUILD (dibaca apps/web/next.config.js)
# ---------------------------------------------------------------------------
# `standalone` -> output yang dipakai image Docker. Build lokal sudah menyetel
# ini via deploy.ps1; di runtime container tidak perlu diubah.
NEXT_OUTPUT=standalone

# ---------------------------------------------------------------------------
# AUTENTIKASI / USER
# ---------------------------------------------------------------------------
# Password default untuk user yang DIBUAT lewat POST /api/admin/users.
# GANTI sebelum produksi. (Dibaca app/api/admin/users/route.ts.)
DEFAULT_USER_PASSWORD=ganti-password-default-user
# Catatan: TTL sesi TIDAK dapat dikonfigurasi lewat env. Nilainya hardcode
# SESSION_TTL_HOURS = 8 di apps/web/lib/auth.ts. Ubah di kode bila perlu.

# ---------------------------------------------------------------------------
# SEED DEMO (HANYA DEMO PERTAMA)
# ---------------------------------------------------------------------------
# true  -> entrypoint menjalankan seed saat container start (data demo ARUN-07).
#         Setelah data awal masuk, WAJIB ubah ke false.
SEED_ON_START=false

# Password untuk seed (dibaca packages/database/src/seed.ts). Login demo:
#   admin@rigdaily.local / <SEED_PASSWORD>
SEED_PASSWORD=ganti-password-seed

# ---------------------------------------------------------------------------
# MODE DEMO PUBLIK (Vercel / showcase tanpa database eksternal)
# ---------------------------------------------------------------------------
# 1 -> aplikasi memakai PGlite in-memory, membuat schema + data contoh otomatis
#      pada request pertama, dan menampilkan login cepat + banner reset.
# WAJIB mengosongkan DATABASE_URL selama mode ini aktif. Bootstrap & reset demo
# otomatis dinonaktifkan bila DATABASE_URL terisi (mencegah TRUNCATE database
# permanen).
RIGDAILY_DEMO=0

# Kunci tanda tangan JWT sesi demo. WAJIB diisi nilai acak panjang di deployment
# publik, mis. `openssl rand -base64 32`. Bila kosong, server memakai nilai
# default yang tertulis di kode (tidak aman).
RIGDAILY_DEMO_SECRET=

# ---------------------------------------------------------------------------
# EMAIL DISTRIBUSI DDR (opsional)
# ---------------------------------------------------------------------------
# Bila SMTP_URL KOSONG -> mode queue-only: email masuk delivery_log sebagai
# `queued`, distributedAt TIDAK diubah, bisa dikirim manual dari Delivery Log.
# Bila diisi, distributor mencoba memuat `nodemailer` (opsional, TIDAK ada di
# package.json). Tanpa nodemailer, tetap queue-only dengan pesan jelas.
#
# Format standar: smtp://user:pass@host:587  (STARTTLS) atau smtps://host:465
SMTP_URL=
# Alamat pengirim (dipakai bila SMTP_URL terisi). Default bila kosong:
#   "RigDaily <no-reply@rigdaily.local>"
SMTP_FROM=RigDaily <no-reply@contoh.com>

# ---------------------------------------------------------------------------
# DOMAIN & DEPLOY
# ---------------------------------------------------------------------------
# Domain publik untuk Caddy + Let's Encrypt (dibaca infra/caddy/Caddyfile).
# Harus sudah menunjuk (DNS A record) ke IP publik VPS SEBELUM caddy start.
DOMAIN=rigdaily.contoh.com

# Image web yang dipakai docker-compose.prod.yml. Awalnya `latest`, lalu
# di-overwrite otomatis oleh infra/scripts/deploy.ps1 saat rollout.
IMAGE_TAG=rigdaily-web:latest

# ---------------------------------------------------------------------------
# BACKUP (dibaca infra/scripts/backup.sh bila diset di .env)
# ---------------------------------------------------------------------------
BACKUP_DIR=/opt/rigdaily/backups
BACKUP_RETENTION_DAYS=14
BACKUP_CADDY_DATA=false
